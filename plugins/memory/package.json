{
  "name": "hpptools-memory",
  "version": "0.1.0",
  "description": "Pi Memory System port for DeepSeek Harness — layered Markdown memory (core-prompt / session notebook / long-term memories) with consolidation & hippocampus subagents",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "config.js",
    "utils.js",
    "diversity.js",
    "memory-ops.js",
    "extract.js",
    "tools.js",
    "markitdown.js",
    "prompt.js",
    "lifecycle.js",
    "subagents.js",
    "commands.js",
    "models.js",
    "runs.js",
    "webui.js",
    "webui.html",
    "cordis.patch.yml",
    "agents/"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "memory",
    "pi-memory-system",
    "subagent",
    "consolidation",
    "hippocampus"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hdaisen/hpptools-memory.git"
  },
  "homepage": "https://github.com/Hdaisen/hpptools-memory#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-user-questions": "*"
  }
}
