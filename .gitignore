node_modules/
# vendored 运行时依赖（内置侧边栏面板所需，随仓库交付使安装脚本无需网络）
!plugins/better-sidebar/node_modules/
!plugins/better-sidebar/node_modules/**
dist/
*.log
.DS_Store
.idea/
.vscode/
*.tsbuildinfo
# 本地安装痕迹（junction 等）
scripts/.installed-*
# 运行时产物
.tmp/

# 临时测试目录（克隆的参考仓库等）
.tmp-test/

# archify 可视化验证产物（含本地绝对路径，不入库）
docs/*.visual-check.*

